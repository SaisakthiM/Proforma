# Copy to .env and replace every change-me value. .env is git-ignored.

# --- Public origin served by the Cloudflare Tunnel --------------------------
PUBLIC_ORIGIN=https://proforma.dpdns.org

# --- Cloudflare Tunnel ------------------------------------------------------
# Zero Trust dashboard -> Networks -> Tunnels -> create tunnel -> copy the token.
# Public hostname: proforma.dpdns.org -> HTTP -> gateway:80
CLOUDFLARE_TUNNEL_TOKEN=change-me

# --- Database ---------------------------------------------------------------
POSTGRES_DB=proforma
POSTGRES_USER=proforma
POSTGRES_PASSWORD=change-me
DB_POOL_SIZE=8

# --- API secrets ------------------------------------------------------------
# 32+ random bytes. Generate with: openssl rand -hex 32
JWT_SECRET=change-me

# --- Feature switches -------------------------------------------------------
SEED_DATABASE=true
CHECKOUT_ENABLED=true
EVENTS_ENABLED=true
SELLER_SIGNUP_ENABLED=true

# --- Pricing ----------------------------------------------------------------
FREE_SHIPPING_THRESHOLD=999.00
SHIPPING_FEE=79.00

# --- Host publishing --------------------------------------------------------
# Bound to 127.0.0.1 only; the tunnel talks to gateway:80 directly.
WEB_PORT=8080
